set -U fish_greeting

{{ if eq .chezmoi.os "darwin" }}
if not command -q brew
    for prefix in $HOMEBREW_PREFIX /opt/homebrew /usr/local
        if test -x "$prefix/bin/brew"
            fish_add_path "$prefix/bin"
            break
        end
    end
end
if command -q brew
    brew shellenv fish | source
end
set -gx EDITOR "zed -n --wait"
fish_add_path ~/Library/Application\ Support/JetBrains/Toolbox/scripts
{{ else }}
set -gx EDITOR "hx"
{{ end }}
fish_add_path ~/.local/bin

if status is-interactive
  starship init fish | source
  enable_transience
  zoxide init fish | source
{{ if eq .chezmoi.os "linux" }}
  if not set -q TMUX && set -q SSH_TTY
    exec tmux new-session -A -s (hostname)
  end
{{ end }}
else if command -q mise
  mise activate fish --shims | source
end

alias ls="eza --icons=always"
abbr -a lla "ls -la"
abbr -a lt "ls --tree"
abbr -a mvn "mvn -T 1C"
