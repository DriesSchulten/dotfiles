{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["~/.config/opencode/codebase-memory.md", "~/.config/opencode/work.md"],
  "mcp": {
    "codebase-memory-mcp": {
      "enabled": true,
      "type": "local",
      "command": ["/Users/dries/.local/bin/codebase-memory-mcp"]
    },
    "idea": {
      "type": "remote",
      "url": "http://127.0.0.1:64342/sse",
      "headers": {}
    }
  },
  "permission": {
    "external_directory": {
      "~/Projects/**": "allow",
      "~/Library/Application Support/rtk/**": "allow"
    },
    "edit": {
      "/tmp/**": "allow"
    }
  },
  "shell": "~/.config/opencode/opencode-agent-shell.sh"
}
