{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [],
  "mcp": {
    "servers": {
      "codebase-memory-mcp": {
        "disabled": false,
        "type": "local",
        "command": [{{ printf "%s/.local/bin/codebase-memory-mcp" .chezmoi.homeDir | quote }}]
      },
      "datadog": {
        "type": "remote",
        "url": "https://mcp.datadoghq.eu/v1/mcp?toolsets=core"
      },
      "idea": {
        "type": "remote",
        "url": "http://127.0.0.1:64342/stream",
        "headers": {}
      }
    }
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "~/Projects/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/Library/Application Support/rtk/**",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "/tmp/**",
      "effect": "allow"
    }
  ],
  "shell": "~/.config/opencode/opencode-agent-shell.sh"
}
