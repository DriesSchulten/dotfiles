// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "button": false
  },
  "git_panel": {
    "dock": "left"
  },
  "project_panel": {
    "dock": "left"
  },
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    }
  },
  "edit_predictions": {
    "provider": "copilot"
  },
  "disable_ai": false,
  "cli_default_open_behavior": "existing_window",
  "ssh_connections": [
    {
      "host": "lunchbox.schulten.network",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/dries"
          ]
        },
        {
          "paths": [
            "/home/dries/.config/containers/systemd"
          ]
        },
        {
          "paths": [
            "~/.config"
          ]
        },
        {
          "paths": [
            "~/containers"
          ]
        }
      ]
    }
  ],
  "vim_mode": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "ui_font_size": 15,
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 10,
  "buffer_line_height": { "custom": 1.5 },
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha"
  },
  "agent": {
    "enabled": true,
  }
}
