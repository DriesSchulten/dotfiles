#!/bin/sh
{{ if eq .chezmoi.os "darwin" }}
export PATH="${HOMEBREW_PREFIX:-/opt/homebrew}/bin:/usr/local/bin:$PATH"
fish_shell=$(command -v fish) || exit 1
user_shell=$(finger $USER | grep 'Shell:*' | cut -f3 -d ":" | xargs)
if [ "$user_shell" != "$fish_shell" ]; then
    grep -Fx "$fish_shell" /private/etc/shells >/dev/null 2>&1 || echo "$fish_shell" | sudo tee -a /private/etc/shells
    chsh -s "$fish_shell"
fi
{{ else }}
chsh -s /usr/bin/fish
{{ end -}}
